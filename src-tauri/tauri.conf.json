{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallis",
  "identifier": "dev.wallis.app",
  "build": {
    "beforeDevCommand": "bun --cwd apps/desktop dev",
    "beforeBuildCommand": "bun --cwd apps/desktop build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Wallis", "width": 900, "height": 760, "minWidth": 560, "minHeight": 600 }],
    "security": { "capabilities": ["default"] }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
